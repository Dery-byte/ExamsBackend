# Environment variables for the exam server. Copy to your host's settings (e.g. Render → Environment).
# Never commit real values.

# ── Database (REQUIRED in production) ──────────────────────────────────────
DB_URL=jdbc:mysql://<host>:<port>/Exam_portal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=<database user>
DB_PASSWORD=<database password>

# ── Sign-in tokens (strongly recommended) ──────────────────────────────────
# Base64 of at least 32 random bytes, e.g.:  openssl rand -base64 48
# If unset the server generates a random key at start-up and everyone is signed out on each restart.
JWT_SECRET_KEY=<base64 key>

# ── Email (password reset, result slips) ───────────────────────────────────
MAILJET_SMTP_USERNAME=
MAILJET_SMTP_PASSWORD=
MAILJET_SMTP_PORT=587

# ── SMS ────────────────────────────────────────────────────────────────────
MNOTIFY_KEY=
MNOTIFY_SENDER_ID=

# ── AI marking providers ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_URL=
GOOGLE.GEMINI.API.KEY=
GOOGLE.GEMINI.API.URL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URLL=
CLAUDE_API_KEY=

# ── Google sign-in (OAuth) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
